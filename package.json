{
  "name": "yhq-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "make-admin": "tsx --env-file-if-exists=.env scripts/make-admin.ts",
    "test:db": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/daily-limit.db.test.ts tests/home.db.test.ts tests/pool.db.test.ts tests/topics.db.test.ts",
    "test:e2e": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/auth.e2e.ts tests/daily-limit.e2e.ts tests/locale.e2e.ts tests/nav.e2e.ts tests/layout.e2e.ts tests/pool.e2e.ts tests/topics.e2e.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed-bulk": "tsx --env-file-if-exists=.env scripts/seed-bulk.ts",
    "bench:pool": "tsx --env-file-if-exists=.env scripts/bench-pool.ts",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-db.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "next": "^15.5.4",
    "nodemailer": "^6.9.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.4.49",
    "prisma": "^6.16.0",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
