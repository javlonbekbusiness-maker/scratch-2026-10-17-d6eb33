# Copy to .env and fill in. Values marked (prod) are only needed before going live.

# ─── Database & cache ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://yhq:yhq@localhost:5432/yhq_test"
# Optional in development (in-memory fallback); required in production for OTP + rate limits.
REDIS_URL="redis://localhost:6379"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Long random string; used to hash OTP codes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"
# Bearer token for GET /api/cron/reminders (call hourly from your scheduler).
CRON_SECRET="change-me"
# Phone number that `npm run db:seed` makes an admin (+998XXXXXXXXX).
ADMIN_PHONE="+998900000001"

# ─── SMS ─────────────────────────────────────────────────────────────────────
# mock = codes printed to the server console (and shown on the OTP screen in dev)
SMS_PROVIDER="mock"            # mock | eskiz | playmobile
ESKIZ_EMAIL=""                 # (prod)
ESKIZ_PASSWORD=""              # (prod)
ESKIZ_FROM="4546"              # (prod) approved sender name
PLAYMOBILE_LOGIN=""            # (prod)
PLAYMOBILE_PASSWORD=""         # (prod)
PLAYMOBILE_ORIGINATOR=""       # (prod)
PLAYMOBILE_URL=""              # (prod) optional endpoint override

# ─── Email (receipts) — leave SMTP_HOST empty to log emails to the console ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="YHQ Test <noreply@example.uz>"

# ─── Payments ────────────────────────────────────────────────────────────────
# true = every provider redirects to the built-in sandbox simulator page
PAYMENTS_SANDBOX="true"
CLICK_MERCHANT_ID=""           # (prod)
CLICK_SERVICE_ID=""            # (prod)
CLICK_SECRET_KEY=""            # (prod) also used to verify callbacks
PAYME_MERCHANT_ID=""           # (prod)
PAYME_SECRET_KEY=""            # (prod)
PAYME_TEST_KEY=""              # Payme sandbox key (used while PAYMENTS_SANDBOX=true)
UZUM_CHECKOUT_URL=""           # (prod) from Uzum merchant contract
UZUM_SECRET_KEY=""             # (prod) shared secret for the callback stub

# ─── AI explainer (optional; without a key the stored explanation is shown) ──
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
